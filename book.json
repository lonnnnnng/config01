      "detail": {
        "request": {"method": "GET", "url": "{bookUrl}", "renderMode": "HTTP"},
        "response": {
          "format": "HTML",
          "fields": {
            "title": {"selector": ".book-title", "value": "TEXT"},
            "cover": {"selector": "img.book-cover-1", "value": "ATTR", "fallbackAttributes": ["data-original", "src"], "resolveUrl": true},
            "author": {"selector": ".book-rand-a:has(a[href^='/boyin/'])", "value": "TEXT", "transforms": [{"type": "REGEX_GROUP", "pattern": "演播[：:]\\s*(.+)", "group": 1}]},
